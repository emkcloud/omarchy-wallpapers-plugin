{
  "schemaVersion": 1,
  "id": "emkcloud.wallpaper-manager",
  "name": "Wallpaper manager",
  "version": "1.4.1",
  "author": "emkcloud",
  "description": "Browse the emkcloud/omarchy-wallpapers collection: install, remove or set the default wallpaper in the local Omarchy theme, with scheduled automatic rotation",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "interface/WallpaperManager.qml",
    "barWidget": "interface/BarLauncher.qml"
  },
  "barWidget": {
    "displayName": "Wallpaper manager",
    "description": "Browse and manage wallpapers",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
